APP_NAME="Nhà hàng Ẩm thực Vườn Phố — E-Menu API"
APP_ENV=development
APP_VERSION=0.1.0
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# Kết nối PostgreSQL 16 (mặc định khớp docker-compose.yml)
DATABASE_URL=postgresql+psycopg://emenu_user:changeme@localhost:5432/emenu_db

# Danh sách origin cho phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Khung cấu hình bảo mật chuẩn bị cho US-04..US-07
JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=60
