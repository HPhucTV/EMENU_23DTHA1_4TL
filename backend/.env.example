APP_NAME="Nhà hàng Ẩm thực Vườn Phố — E-Menu API"
APP_ENV=development
APP_VERSION=0.1.0
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# Kết nối PostgreSQL 16 (mặc định khớp docker-compose.yml)
DATABASE_URL=postgresql+psycopg://emenu_user:changeme@localhost:5432/emenu_db

# Danh sách origin cho phép gọi API (cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Khung cấu hình bảo mật & xác thực (FR-01)
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REMEMBER_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFY_EXPIRE_HOURS=24

# Dịch vụ Email xác thực & thông báo (console | smtp | brevo — xem docs/PAYMENT_EMAIL_SMS_RESEARCH.md)
EMAIL_PROVIDER=console
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_NAME="Nhà hàng Ẩm thực Vườn Phố"
EMAIL_FROM_ADDRESS=no-reply@vuonpho.vn
